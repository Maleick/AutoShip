{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "TextQuest Neriak",
    "description": "Unified design tokens for TextQuest web dashboard and ratatui TUI. Source of truth mirrors textquest/src/tui/theme/mod.rs::neriak().",
    "version": "0.1.0"
  },
  "color": {
    "bg": {
      "void": {
        "hex": "#0d0618",
        "rgb": [13, 6, 24],
        "role": "app background"
      },
      "panel": {
        "hex": "#1a0a2e",
        "rgb": [26, 10, 46],
        "role": "panel / card"
      },
      "elevated": {
        "hex": "#2d1e41",
        "rgb": [45, 30, 65],
        "role": "elevated surface"
      }
    },
    "accent": {
      "magenta": {
        "hex": "#cc44ff",
        "rgb": [204, 68, 255],
        "role": "primary accent"
      },
      "magenta_bright": {
        "hex": "#ff00ff",
        "rgb": [255, 0, 255],
        "role": "server / high-emphasis glow"
      },
      "cyan": {
        "hex": "#00e5ff",
        "rgb": [0, 229, 255],
        "role": "active / focus"
      }
    },
    "text": {
      "primary": {
        "hex": "#e2d7f4",
        "rgb": [226, 215, 244],
        "role": "body text"
      },
      "muted": {
        "hex": "#a096b4",
        "rgb": [160, 150, 180],
        "role": "secondary text"
      },
      "dim": {
        "hex": "#503c6e",
        "rgb": [80, 60, 110],
        "role": "disabled / separator"
      }
    },
    "state": {
      "ok": {
        "hex": "#34d399",
        "rgb": [52, 211, 153],
        "role": "success / healthy"
      },
      "warn": {
        "hex": "#fbbf24",
        "rgb": [251, 191, 36],
        "role": "warning / degraded"
      },
      "danger": {
        "hex": "#ef4444",
        "rgb": [239, 68, 68],
        "role": "error / blocked"
      },
      "info": { "hex": "#60a5fa", "rgb": [96, 165, 250], "role": "info / mana" }
    }
  },
  "font": {
    "display": {
      "stack": "Cinzel, 'IM Fell English', Georgia, serif",
      "role": "page headings / hero"
    },
    "body": {
      "stack": "Inter, system-ui, -apple-system, sans-serif",
      "role": "body / UI labels"
    },
    "mono": {
      "stack": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace",
      "role": "telemetry numerics / code"
    }
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "6px"
  },
  "border": {
    "width": "1px",
    "style": "solid"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px"
  },
  "semantic": {
    "clients": "accent.cyan",
    "groups": "state.ok",
    "economy": "state.warn",
    "danger": "state.danger",
    "server": "accent.magenta_bright"
  }
}
