fn mana_and_target_hp_above(mana_pct: f32, target_hp_pct: f32) -> ConditionExpr {
    ConditionExpr::And(vec![
        ConditionExpr::ManaAbove(mana_pct),
        ConditionExpr::TargetHpAbove(target_hp_pct),
    ])
}

