{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(chmod 600:*)",
      "mcp__plugin_discord_discord__reply"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/xmale/Projects/DMFT/.claude/hooks/rust-fmt.sh",
            "statusMessage": "Formatting Rust..."
          },
          {
            "type": "command",
            "command": "bash C:/Users/xmale/Projects/DMFT/.claude/hooks/rust-clippy.sh",
            "timeout": 120,
            "statusMessage": "Running clippy..."
          }
        ]
      }
    ]
  }
}
